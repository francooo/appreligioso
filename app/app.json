{
  "expo": {
    "name": "Lumina",
    "slug": "lumina",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.francooo.lumina"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FBF5EC",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.francooo.lumina"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Lumina",
      "shortName": "Lumina",
      "lang": "pt-BR",
      "themeColor": "#FBF5EC",
      "backgroundColor": "#FBF5EC",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#FBF5EC"
        }
      ],
      [
        "react-native-nitro-google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.471522397558-prav14pvcopf2liqm9a0vdl5r3qa3gll"
        }
      ],
      "expo-secure-store",
      "expo-status-bar",
      "expo-router"
    ],
    "scheme": "lumina",
    "extra": {
      "eas": {
        "projectId": "f6e7e5d0-ab57-4755-82fa-133447b0dcbb"
      }
    },
    "owner": "francooo"
  }
}
